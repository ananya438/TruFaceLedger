
# SerpApi API Key for Google Lens / Reverse Image Search
SERPAPI_KEY=your_serpapi_key_here

# Alchemy Polygon Amoy Testnet RPC URL
ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_alchemy_api_key

# MetaMask Private Key (hex string without 0x prefix, or with 0x)
PRIVATE_KEY=your_private_key_here

# Wallet Address associated with the private key (0x...)
WALLET_ADDRESS=0xYourWalletAddressHere
